{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noxta-studio",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  // Pure static site — every file in the repo is served as a static asset.
  // .assetsignore keeps .git, scripts/, etc. out. No Worker: there are no
  // dynamic routes (the contact form posts directly to web3forms).
  "assets": {
    "directory": "."
  }
}
