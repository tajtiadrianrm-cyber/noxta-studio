{
  "site": {
    "name": "Noxta Studio",
    "viewUrl": "https://noxta.studio"
  },
  "media": {
    "folder": "assets/cms",
    "publicPrefix": "/assets/cms"
  },
  "collections": [
    {
      "id": "home",
      "label": "Home page content",
      "file": "content/home.json",
      "kind": "single",
      "fields": [
        {
          "name": "hero",
          "label": "Hero — top of page",
          "widget": "object",
          "fields": [
            { "name": "statusPill",     "label": "Status pill (top-left)",            "widget": "string" },
            { "name": "topMeta",        "label": "Top-right meta",                     "widget": "string" },
            { "name": "nameLine1",      "label": "Name — line 1 (white)",              "widget": "string" },
            { "name": "nameLine2",      "label": "Name — line 2 (orange gradient)",    "widget": "string" },
            { "name": "role",           "label": "Role line under the name",           "widget": "string" },
            { "name": "bio",            "label": "Bio paragraph",                      "widget": "text", "rows": 6 },
            { "name": "primaryLabel",   "label": "Primary button text",                "widget": "string" },
            { "name": "secondaryLabel", "label": "Secondary button text",              "widget": "string" }
          ]
        },
        {
          "name": "intro",
          "label": "Intro — 'Just me. No agency.'",
          "widget": "object",
          "fields": [
            { "name": "label",        "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1",      "label": "Headline — line 1 (white)",          "widget": "string" },
            { "name": "h1Line2Grad",  "label": "Line 2 — orange gradient portion",   "widget": "string" },
            { "name": "h1Line2Tail",  "label": "Line 2 — trailing portion",          "widget": "string" },
            { "name": "sub",          "label": "Subtitle paragraph",                 "widget": "text", "rows": 4 }
          ]
        },
        {
          "name": "servicesSection",
          "label": "Services — section header",
          "widget": "object",
          "fields": [
            { "name": "label",   "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1", "label": "Headline — line 1",                  "widget": "string" },
            { "name": "h1Line2", "label": "Headline — line 2",                  "widget": "string" },
            { "name": "sub",     "label": "Subtitle",                           "widget": "text", "rows": 3 }
          ]
        },
        {
          "name": "services",
          "label": "Services — the 4 cards",
          "widget": "list",
          "itemLabel": "{{n}} {{title}}",
          "itemSingular": "service",
          "itemSchema": {
            "fields": [
              { "name": "n",     "label": "Number (e.g. /01)",          "widget": "string" },
              { "name": "title", "label": "Title (e.g. Websites)",      "widget": "string" },
              { "name": "tags",  "label": "Tags",                        "widget": "string-list" },
              { "name": "desc",  "label": "Description",                 "widget": "text", "rows": 3 }
            ]
          }
        },
        {
          "name": "workSection",
          "label": "Selected work — section header",
          "widget": "object",
          "fields": [
            { "name": "label",   "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1", "label": "Headline — line 1 (white)",          "widget": "string" },
            { "name": "h1Line2", "label": "Headline — line 2 (orange gradient)", "widget": "string" }
          ]
        },
        {
          "name": "work",
          "label": "Selected work — VOEP case card",
          "widget": "object",
          "fields": [
            { "name": "tag",      "label": "Tag (top of card)",            "widget": "string" },
            { "name": "title",    "label": "Title",                        "widget": "string" },
            { "name": "sub",      "label": "Description",                  "widget": "text", "rows": 5 },
            { "name": "ctaLabel", "label": "Button text",                  "widget": "string" },
            {
              "name": "cells",
              "label": "4 metric cells",
              "widget": "list",
              "itemLabel": "{{label}} → {{value}}",
              "itemSingular": "cell",
              "itemSchema": {
                "fields": [
                  { "name": "label", "label": "Label", "widget": "string" },
                  { "name": "value", "label": "Value", "widget": "string" }
                ]
              }
            }
          ]
        },
        {
          "name": "strip",
          "label": "Static strip — between Work and Believe",
          "widget": "object",
          "fields": [
            { "name": "text", "label": "Strip text", "widget": "string" }
          ]
        },
        {
          "name": "believeSection",
          "label": "Believe — section header",
          "widget": "object",
          "fields": [
            { "name": "label",   "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1", "label": "Headline — line 1",                  "widget": "string" },
            { "name": "h1Line2", "label": "Headline — line 2",                  "widget": "string" }
          ]
        },
        {
          "name": "believe",
          "label": "Believe — 3 belief cards",
          "widget": "list",
          "itemLabel": "{{n}} {{h}}",
          "itemSingular": "belief",
          "itemSchema": {
            "fields": [
              { "name": "n", "label": "Number (e.g. /01)", "widget": "string" },
              { "name": "h", "label": "Headline",          "widget": "string" },
              { "name": "p", "label": "Paragraph",         "widget": "text", "rows": 5 }
            ]
          }
        },
        {
          "name": "pricingSection",
          "label": "Pricing — section header + tabs",
          "widget": "object",
          "fields": [
            { "name": "label",      "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1",    "label": "Headline — line 1",                  "widget": "string" },
            { "name": "h1Line2",    "label": "Headline — line 2",                  "widget": "string" },
            { "name": "sub",        "label": "Subtitle",                            "widget": "text", "rows": 3 },
            { "name": "tabOnetime", "label": "Tab 1 label",                         "widget": "string" },
            { "name": "tabMonthly", "label": "Tab 2 label",                         "widget": "string" }
          ]
        },
        {
          "name": "pricingOnetime",
          "label": "Pricing — one-time project tiers",
          "widget": "list",
          "itemLabel": "{{tier}} · {{name}} · {{amount}}",
          "itemSingular": "tier",
          "itemSchema": {
            "fields": [
              { "name": "flag",   "label": "Flag (e.g. Recommended) — empty for none", "widget": "string" },
              { "name": "tier",   "label": "Tier label (e.g. Tier · I)",               "widget": "string" },
              { "name": "amount", "label": "Amount (e.g. €600 – 1,200)",                "widget": "string" },
              { "name": "name",   "label": "Tier name (e.g. Small)",                    "widget": "string" },
              { "name": "desc",   "label": "Short description",                          "widget": "string" },
              { "name": "feats",  "label": "Features (one per line)",                    "widget": "string-list" },
              { "name": "ideal",  "label": "Ideal-for paragraph",                        "widget": "text", "rows": 3 }
            ]
          }
        },
        {
          "name": "pricingMonthly",
          "label": "Pricing — monthly retainer plans",
          "widget": "list",
          "itemLabel": "{{tier}} · {{name}} · {{amount}}",
          "itemSingular": "plan",
          "itemSchema": {
            "fields": [
              { "name": "flag",   "label": "Flag (e.g. Recommended) — empty for none", "widget": "string" },
              { "name": "tier",   "label": "Plan label (e.g. Plan · I)",                "widget": "string" },
              { "name": "amount", "label": "Amount (e.g. €50 / month)",                  "widget": "string" },
              { "name": "name",   "label": "Plan name (e.g. Light)",                     "widget": "string" },
              { "name": "desc",   "label": "Short description",                          "widget": "string" },
              { "name": "feats",  "label": "Features (one per line)",                    "widget": "string-list" },
              { "name": "ideal",  "label": "Ideal-for paragraph",                        "widget": "text", "rows": 3 }
            ]
          }
        },
        {
          "name": "cta",
          "label": "CTA — 'Let's talk.'",
          "widget": "object",
          "fields": [
            { "name": "labelTL",        "label": "Top-left mark — main",       "widget": "string" },
            { "name": "subTL",          "label": "Top-left mark — sub",        "widget": "string" },
            { "name": "labelTR",        "label": "Top-right mark — main",      "widget": "string" },
            { "name": "subTR",          "label": "Top-right mark — sub",       "widget": "string" },
            { "name": "h1Line1",        "label": "Headline part (white)",       "widget": "string" },
            { "name": "h1Line2",        "label": "Headline part (orange gradient)", "widget": "string" },
            { "name": "lede",           "label": "Lede paragraph",              "widget": "text", "rows": 4 },
            { "name": "primaryLabel",   "label": "Primary button text",         "widget": "string" },
            { "name": "secondaryLabel", "label": "Secondary button text",       "widget": "string" },
            { "name": "noteText",       "label": "Note before phone",           "widget": "string" },
            { "name": "notePhone",      "label": "Phone number (display)",      "widget": "string" },
            { "name": "noteTail",       "label": "Tail (after phone, e.g. · I read every message)", "widget": "string" }
          ]
        },
        {
          "name": "spec",
          "label": "Spec bar — 4 stats",
          "widget": "list",
          "itemLabel": "{{label}} → {{value}}",
          "itemSingular": "spec",
          "itemSchema": {
            "fields": [
              { "name": "label", "label": "Label", "widget": "string" },
              { "name": "value", "label": "Value", "widget": "string" }
            ]
          }
        },
        {
          "name": "footer",
          "label": "Footer — brand block",
          "widget": "object",
          "fields": [
            { "name": "studioLine", "label": "Studio line", "widget": "string" },
            { "name": "bio",        "label": "Bio",         "widget": "text", "rows": 4 }
          ]
        }
      ]
    },
    {
      "id": "portfolio",
      "label": "Portfolio",
      "file": "content/portfolio.json",
      "kind": "list",
      "listPath": "items",
      "itemLabel": "{{title}} — {{status}}",
      "itemSingular": "case",
      "fields": [
        {
          "name": "n",
          "label": "Case number",
          "widget": "string",
          "placeholder": "e.g. Case 004",
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "widget": "select",
          "options": ["Live", "Coming Q3 2026", "Coming Q4 2026", "Drafting", "Archived"],
          "required": true
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string",
          "placeholder": "Short, distinctive name",
          "required": true
        },
        {
          "name": "subtitle",
          "label": "Subtitle",
          "widget": "string",
          "placeholder": "One-liner under the title"
        },
        {
          "name": "body",
          "label": "Description",
          "widget": "text",
          "rows": 6,
          "placeholder": "What was built, in plain language"
        },
        {
          "name": "tags",
          "label": "Tags",
          "widget": "string-list",
          "placeholder": "Type a tag and press Enter"
        },
        {
          "name": "cta",
          "label": "Button",
          "widget": "object",
          "fields": [
            { "name": "label", "label": "Button label", "widget": "string", "placeholder": "Read the full case →" },
            { "name": "href",  "label": "Button link",  "widget": "url",    "placeholder": "https://… or /contact" }
          ]
        },
        {
          "name": "shot",
          "label": "Screenshot",
          "widget": "image",
          "hint": "Optional. Leave empty for upcoming cases."
        }
      ]
    },
    {
      "id": "portfolio-page",
      "label": "Portfolio page content",
      "file": "content/portfolio-page.json",
      "kind": "single",
      "fields": [
        {
          "name": "hero",
          "label": "Hero — top of page",
          "widget": "object",
          "fields": [
            { "name": "statusPill", "label": "Status pill (top-left)",            "widget": "string" },
            { "name": "topMeta",    "label": "Top-right meta",                     "widget": "string" },
            { "name": "crumb",      "label": "Breadcrumb — current page",          "widget": "string" },
            { "name": "h1Line1",    "label": "Headline — line 1 (white)",          "widget": "string" },
            { "name": "h1Line2",    "label": "Headline — line 2 (orange gradient)", "widget": "string" },
            { "name": "sub",        "label": "Subtitle paragraph",                 "widget": "text", "rows": 4 }
          ]
        },
        {
          "name": "stepsSection",
          "label": "Steps section — header",
          "widget": "object",
          "fields": [
            { "name": "label",   "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1", "label": "Headline — line 1 (white)",          "widget": "string" },
            { "name": "h1Line2", "label": "Headline — line 2 (orange gradient)", "widget": "string" },
            { "name": "sub",     "label": "Subtitle",                           "widget": "text", "rows": 3 }
          ]
        },
        {
          "name": "steps",
          "label": "Steps — the 4 process cards",
          "widget": "list",
          "itemLabel": "{{n}} {{title}}",
          "itemSingular": "step",
          "itemSchema": {
            "fields": [
              { "name": "n",     "label": "Number (e.g. /01)",       "widget": "string" },
              { "name": "title", "label": "Step title",              "widget": "string" },
              { "name": "when",  "label": "Timeline (e.g. 30 min)",  "widget": "string" },
              { "name": "body",  "label": "Description",             "widget": "text", "rows": 4 }
            ]
          }
        },
        {
          "name": "cta",
          "label": "CTA — bottom call-to-action",
          "widget": "object",
          "fields": [
            { "name": "label",          "label": "Section label",                      "widget": "string" },
            { "name": "h1Line1",        "label": "Headline — line 1 (white)",          "widget": "string" },
            { "name": "h1Line2",        "label": "Headline — line 2 (orange gradient)", "widget": "string" },
            { "name": "primaryLabel",   "label": "Primary button text",                "widget": "string" },
            { "name": "secondaryLabel", "label": "Secondary button text",              "widget": "string" }
          ]
        },
        {
          "name": "spec",
          "label": "Spec bar — 4 stats below the CTA",
          "widget": "list",
          "itemLabel": "{{label}} → {{value}}",
          "itemSingular": "spec",
          "itemSchema": {
            "fields": [
              { "name": "label", "label": "Label (e.g. // Studio est.)", "widget": "string" },
              { "name": "value", "label": "Value (e.g. 2026)",           "widget": "string" }
            ]
          }
        },
        {
          "name": "footer",
          "label": "Footer — brand block",
          "widget": "object",
          "fields": [
            { "name": "studioLine", "label": "Studio line (small caps)", "widget": "string" },
            { "name": "bio",        "label": "Bio paragraph",            "widget": "text", "rows": 4 }
          ]
        }
      ]
    }
  ]
}
